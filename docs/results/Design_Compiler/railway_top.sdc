###################################################################

# Created by write_sdc on Mon Sep  7 06:59:00 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current uA
set_max_fanout 16 [current_design]
create_clock [get_ports clk]  -period 10  -waveform {0 5}
set_clock_uncertainty -setup 0.2  [get_clocks clk]
set_clock_uncertainty -hold 0.05  [get_clocks clk]
set_input_delay -clock clk  1  [get_ports reset]
set_input_delay -clock clk  1  [get_ports train_request]
set_input_delay -clock clk  1  [get_ports {train_id[5]}]
set_input_delay -clock clk  1  [get_ports {train_id[4]}]
set_input_delay -clock clk  1  [get_ports {train_id[3]}]
set_input_delay -clock clk  1  [get_ports {train_id[2]}]
set_input_delay -clock clk  1  [get_ports {train_id[1]}]
set_input_delay -clock clk  1  [get_ports {train_id[0]}]
set_input_delay -clock clk  1  [get_ports {entry_track[2]}]
set_input_delay -clock clk  1  [get_ports {entry_track[1]}]
set_input_delay -clock clk  1  [get_ports {entry_track[0]}]
set_input_delay -clock clk  1  [get_ports direction]
set_input_delay -clock clk  1  [get_ports {train_type[1]}]
set_input_delay -clock clk  1  [get_ports {train_type[0]}]
set_input_delay -clock clk  1  [get_ports emergency_flag]
set_input_delay -clock clk  1  [get_ports {timestamp[7]}]
set_input_delay -clock clk  1  [get_ports {timestamp[6]}]
set_input_delay -clock clk  1  [get_ports {timestamp[5]}]
set_input_delay -clock clk  1  [get_ports {timestamp[4]}]
set_input_delay -clock clk  1  [get_ports {timestamp[3]}]
set_input_delay -clock clk  1  [get_ports {timestamp[2]}]
set_input_delay -clock clk  1  [get_ports {timestamp[1]}]
set_input_delay -clock clk  1  [get_ports {timestamp[0]}]
set_input_delay -clock clk  1  [get_ports track_busy]
set_input_delay -clock clk  1  [get_ports signal_fault]
set_output_delay -clock clk  1  [get_ports signal_red]
set_output_delay -clock clk  1  [get_ports signal_yellow]
set_output_delay -clock clk  1  [get_ports signal_green]
set_output_delay -clock clk  1  [get_ports switch_left]
set_output_delay -clock clk  1  [get_ports switch_right]
set_output_delay -clock clk  1  [get_ports train_move]
set_input_transition -max 0.1  [get_ports reset]
set_input_transition -min 0.1  [get_ports reset]
set_input_transition -max 0.1  [get_ports train_request]
set_input_transition -min 0.1  [get_ports train_request]
set_input_transition -max 0.1  [get_ports {train_id[5]}]
set_input_transition -min 0.1  [get_ports {train_id[5]}]
set_input_transition -max 0.1  [get_ports {train_id[4]}]
set_input_transition -min 0.1  [get_ports {train_id[4]}]
set_input_transition -max 0.1  [get_ports {train_id[3]}]
set_input_transition -min 0.1  [get_ports {train_id[3]}]
set_input_transition -max 0.1  [get_ports {train_id[2]}]
set_input_transition -min 0.1  [get_ports {train_id[2]}]
set_input_transition -max 0.1  [get_ports {train_id[1]}]
set_input_transition -min 0.1  [get_ports {train_id[1]}]
set_input_transition -max 0.1  [get_ports {train_id[0]}]
set_input_transition -min 0.1  [get_ports {train_id[0]}]
set_input_transition -max 0.1  [get_ports {entry_track[2]}]
set_input_transition -min 0.1  [get_ports {entry_track[2]}]
set_input_transition -max 0.1  [get_ports {entry_track[1]}]
set_input_transition -min 0.1  [get_ports {entry_track[1]}]
set_input_transition -max 0.1  [get_ports {entry_track[0]}]
set_input_transition -min 0.1  [get_ports {entry_track[0]}]
set_input_transition -max 0.1  [get_ports direction]
set_input_transition -min 0.1  [get_ports direction]
set_input_transition -max 0.1  [get_ports {train_type[1]}]
set_input_transition -min 0.1  [get_ports {train_type[1]}]
set_input_transition -max 0.1  [get_ports {train_type[0]}]
set_input_transition -min 0.1  [get_ports {train_type[0]}]
set_input_transition -max 0.1  [get_ports emergency_flag]
set_input_transition -min 0.1  [get_ports emergency_flag]
set_input_transition -max 0.1  [get_ports {timestamp[7]}]
set_input_transition -min 0.1  [get_ports {timestamp[7]}]
set_input_transition -max 0.1  [get_ports {timestamp[6]}]
set_input_transition -min 0.1  [get_ports {timestamp[6]}]
