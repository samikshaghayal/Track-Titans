set_input_transition -min 0.1  [get_ports {timestamp[4]}]
set_input_transition -max 0.1  [get_ports {timestamp[3]}]
set_input_transition -min 0.1  [get_ports {timestamp[3]}]
set_input_transition -max 0.1  [get_ports {timestamp[2]}]
set_input_transition -min 0.1  [get_ports {timestamp[2]}]
set_input_transition -max 0.1  [get_ports {timestamp[1]}]
set_input_transition -min 0.1  [get_ports {timestamp[1]}]
set_input_transition -max 0.1  [get_ports {timestamp[0]}]
set_input_transition -min 0.1  [get_ports {timestamp[0]}]
set_input_transition -max 0.1  [get_ports track_busy]
set_input_transition -min 0.1  [get_ports track_busy]
set_input_transition -max 0.1  [get_ports signal_fault]
set_input_transition -min 0.1  [get_ports signal_fault]
